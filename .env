# Valeurs par défaut, injectées dans l'app au build par Vite.
# Seules les variables préfixées par VITE_ sont exposées à l'app.
# Pour surcharger localement (ou sur le NAS) sans commiter : créer un .env.local
VITE_DISCOGS_BASE_URL=https://api.discogs.com
# Liste "utilisateur:Libellé" séparée par des virgules (libellé facultatif)
VITE_DISCOGS_COLLECTIONS=laureanne.leneel:Laure-Anne,shookete:Jeremy
